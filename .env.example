# WEBBY AI Configuration
# Port for backend server
PORT=3001

# Google Gemini API Key (Optional: Webby will run in Smart Offline Mode if omitted)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model (e.g. gemini-1.5-flash, gemini-2.0-flash, or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash

