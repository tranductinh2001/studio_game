# ========================================================
# WEBBY CLASSROOM - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Môi trường chạy ứng dụng: 'development' hoặc 'production'
VITE_APP_ENV=development

# Base URL của Backend API. 
# Để trống để hệ thống tự động nhận diện theo môi trường (Khuyến nghị)
# Khi chạy Local: Tự động dùng http://localhost:3001/api hoặc http://<LAN_IP>:3001/api
# Khi chạy Vercel: Tự động dùng /api
VITE_API_BASE_URL=

# Khóa API Google Gemini dành cho tính năng sư phạm và trợ lý AI Webby (Tuỳ chọn)
GEMINI_API_KEY=

# Cổng khởi chạy hệ thống
PORT=3001
VITE_PORT=5173

